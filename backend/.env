# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=3001

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth ---
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email of the first admin account. Register that address in the app, then run:
#   npm run db:promote -- you@example.com
ADMIN_EMAIL=

# --- Database ---
# Defaults to backend/fashionhub.db
# DB_PATH=./fashionhub.db

# --- Payments (Phase 4 — not wired up yet) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Misc ---
# Set to true to have Express also serve ../frontend/dist on the same origin
SERVE_STATIC=false
